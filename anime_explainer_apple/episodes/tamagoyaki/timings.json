{
 "duration": 132.64,
 "sentences": [
  {
   "i": 0,
   "text": "卵焼きを作ると、いつもパサパサになる。",
   "start": 0,
   "end": 3.76
  },
  {
   "i": 1,
   "text": "そんな経験はありませんか。",
   "start": 3.76,
   "end": 6.24
  },
  {
   "i": 2,
   "text": "実は、ふわふわにするコツは、たった二つなんです。",
   "start": 6.24,
   "end": 10.64
  },
  {
   "i": 3,
   "text": "それは、泡立てないことと、弱火のまま焼くことです。",
   "start": 10.64,
   "end": 15.6
  },
  {
   "i": 4,
   "text": "今日は、ふわふわ卵焼きを作りましょう。",
   "start": 15.68,
   "end": 19.44
  },
  {
   "i": 5,
   "text": "材料は、二人分で、たまご三個、砂糖大さじ一、しょうゆ小さじ半分、サラダ油少々です。",
   "start": 19.44,
   "end": 30.16
  },
  {
   "i": 6,
   "text": "まず、ボウルに卵を割り入れます。",
   "start": 30.44,
   "end": 33.6
  },
  {
   "i": 7,
   "text": "白身を切るように、箸を左右に動かしてまぜましょう。",
   "start": 33.6,
   "end": 38.08
  },
  {
   "i": 8,
   "text": "まぜすぎて泡立てないのが、いちばんのコツです。",
   "start": 38.08,
   "end": 42.32
  },
  {
   "i": 9,
   "text": "次に、砂糖としょうゆを入れます。",
   "start": 42.32,
   "end": 45.28
  },
  {
   "i": 10,
   "text": "砂糖には、卵をやわらかく仕上げる働きがあると言われています。",
   "start": 45.28,
   "end": 50.4
  },
  {
   "i": 11,
   "text": "ここで、ひとつだけ。",
   "start": 50.4,
   "end": 52.32
  },
  {
   "i": 12,
   "text": "入れたら、軽くまぜるだけで大丈夫です。",
   "start": 52.32,
   "end": 56.08
  },
  {
   "i": 13,
   "text": "フライパンに油をなじませて、弱火で温めます。",
   "start": 56.08,
   "end": 60.56
  },
  {
   "i": 14,
   "text": "卵液の三分の一を流し入れて、三分ほど焼きましょう。",
   "start": 60.56,
   "end": 65.52
  },
  {
   "i": 15,
   "text": "火が強いと、焦げてかたくなるので、弱火のままです。",
   "start": 65.52,
   "end": 70.08
  },
  {
   "i": 16,
   "text": "表面が半熟のうちに、奥から手前にくるくると巻きます。",
   "start": 70.08,
   "end": 76
  },
  {
   "i": 17,
   "text": "巻いたら奥に戻して、また卵液を流します。",
   "start": 76,
   "end": 80.4
  },
  {
   "i": 18,
   "text": "これをあと二回くり返します。",
   "start": 80.4,
   "end": 84.08
  },
  {
   "i": 19,
   "text": "さて、ここで雑学クイズです。",
   "start": 84.08,
   "end": 87.6
  },
  {
   "i": 20,
   "text": "卵の白身が固まり始める温度は、何度くらいでしょうか。",
   "start": 87.6,
   "end": 92.72
  },
  {
   "i": 21,
   "text": "ひとつめ、五十度。",
   "start": 92.72,
   "end": 95.44
  },
  {
   "i": 22,
   "text": "ふたつめ、六十度。",
   "start": 95.44,
   "end": 98.24
  },
  {
   "i": 23,
   "text": "みっつめ、九十度。",
   "start": 98.24,
   "end": 101.28
  },
  {
   "i": 24,
   "text": "正解は、ふたつめの、六十度くらいと言われています。",
   "start": 101.28,
   "end": 106.08
  },
  {
   "i": 25,
   "text": "思ったより低いですよね。",
   "start": 106.08,
   "end": 108.47999999999999
  },
  {
   "i": 26,
   "text": "だから、弱火でじっくりが大切なんです。",
   "start": 108.47999999999999,
   "end": 112.24
  },
  {
   "i": 27,
   "text": "卵には、しっかり火を通してから、食べてくださいね。",
   "start": 112.24,
   "end": 117.44
  },
  {
   "i": 28,
   "text": "最後に、コツをもう一度。",
   "start": 117.44,
   "end": 120.24
  },
  {
   "i": 29,
   "text": "泡立てない、弱火のまま。",
   "start": 120.24,
   "end": 123.19999999999999
  },
  {
   "i": 30,
   "text": "これだけで、卵焼きはふわふわになります。",
   "start": 123.19999999999999,
   "end": 126.8
  },
  {
   "i": 31,
   "text": "ぜひ、作ってみてください。",
   "start": 126.8,
   "end": 129.6
  },
  {
   "i": 32,
   "text": "次回は、とろとろオムレツの作り方です。",
   "start": 129.6,
   "end": 132.64
  }
 ]
}